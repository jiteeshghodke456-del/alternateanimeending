# Copy to .env for local runs. Never commit real values. On Hugging Face, set these as Space secrets.
# Every comment sits on its own line: `docker run --env-file` keeps everything after "=" as the value,
# so a comment after a value would become part of the value and break startup.

# Jev (the SDK reads this automatically)
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# DeepSeek fast mode; any OpenAI-compatible provider works
LLM_MODEL=deepseek-chat
# For the cost meter; vendor list price, update if it changes
JEV_USD_PER_M_INPUT=0.042
# Role picker, seeded brand, reset endpoint
DEMO_MODE=1
# P1-3 guideline PDF import; 0 = endpoints return 501
FEATURE_PDF_IMPORT=1

# Memory budget (Render free tier = 512 MiB; DECISIONS.md "Memory budget on Render free tier")
# Checks + audience runs + PDF imports at once; the rest queue
MAX_CONCURRENT_CHECKS=2
# Startup demo pre-run waits this long (server healthy first)
PRERUN_DELAY_S=15
# Images sent to Jev are downscaled to this long side
IMAGE_MAX_SIDE=1024
# Logo match: largest piece one SIFT pass sees; bigger images are tiled
SIFT_MAX_SIDE=640
# Jev calls in flight per process
JEV_CONCURRENCY=8

# Server
# Long random string in production; dev default is insecure
SESSION_SECRET=
DB_PATH=/tmp/brandgate.db
UPLOAD_DIR=/tmp/brandgate_uploads
# Per-visitor workspaces (DECISIONS.md "Workspaces"): each visitor gets their own copy of the demo or a blank brand
# 0 = everyone shares the one DB at DB_PATH (the old behaviour)
WORKSPACES_ENABLED=1
WORKSPACES_DIR=/tmp/brandgate_ws
# Least recently used are deleted beyond this (about 0.3 MB of disk each)
MAX_WORKSPACES=200
# A workspace with a signed-in request in the last hour is only deleted beyond this hard cap
MAX_WORKSPACES_HARD=300
# Deleted after this many hours without a request
WORKSPACE_TTL_H=12
# Optional: override the seed directory
# SEED_DIR=
# Optional: defaults to <repo>/frontend/dist
# FRONTEND_DIST=
