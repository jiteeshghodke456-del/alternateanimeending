# Copy to .env for local runs. Never commit real values. On Hugging Face, set these as Space secrets.
TYPESAFE_API_KEY=            # Jev (the SDK reads this automatically)
TYPESAFE_DEFAULT_MODEL=jev-latest
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat          # DeepSeek fast mode; any OpenAI-compatible provider works
JEV_USD_PER_M_INPUT=0.042        # for the cost meter; vendor list price, update if it changes
DEMO_MODE=1                      # role picker, seeded brand, reset endpoint
FEATURE_PDF_IMPORT=1            # P1-3 guideline PDF import; 0 = endpoints return 501

# Server
SESSION_SECRET=                  # long random string in production; dev default is insecure
DB_PATH=/tmp/brandgate.db
UPLOAD_DIR=/tmp/brandgate_uploads
# SEED_DIR=                      # optional: override the seed directory
# FRONTEND_DIST=                 # optional: defaults to <repo>/frontend/dist
